# ==============================================================================
# Kavach Smart Helmet — Repository .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 2. ENVIRONMENT VARIABLES & SECRETS (NEVER COMMIT SENSITIVE KEYS)
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
*.env
aws_credentials/
*.pem
*.key

# Preserve committed example templates
!.env.example
!*.tfvars.example

# Service accounts & Cloud credentials
*.service-account.json
*firebase-adminsdk*.json
serviceAccountKey.json

# ------------------------------------------------------------------------------
# 3. FIREBASE & CLOUD BACKEND
# ------------------------------------------------------------------------------
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# ------------------------------------------------------------------------------
# 4. EXPO & REACT NATIVE (FRONTEND)
# ------------------------------------------------------------------------------
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 5. NATIVE MOBILE BUILDS (CONTINUOUS NATIVE GENERATION)
# ------------------------------------------------------------------------------
/ios
/android
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.mobileprovision

# ------------------------------------------------------------------------------
# 6. FIRMWARE & HARDWARE ARTIFACTS
# ------------------------------------------------------------------------------
# Per-device credentials & configurations (gitignored; see config.example.h)
/firmware/KavachHelmet/config.h
/firmware/smart_helmet/config.h
firmware/**/config.h

# Firmware compiled test binaries & intermediate objects
firmware/**/build/
.test-build/
*.o
*.a
*.elf
*.bin
*.hex
*.exe

# PlatformIO / Arduino IDE artifacts
.pio/
.pioenvs/
.piolibdeps/

# ------------------------------------------------------------------------------
# 7. TERRAFORM (INFRASTRUCTURE AS CODE)
# ------------------------------------------------------------------------------
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl

# ------------------------------------------------------------------------------
# 8. LOGS & DIAGNOSTICS
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 9. OS & EDITOR METADATA
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.eslintcache

# ------------------------------------------------------------------------------
# 10. PYTHON & ENVIRONMENT (IF RUNNING UTILITIES)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# ------------------------------------------------------------------------------
# 11. COVERAGE & TEMPORARY DATA
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
.cache/
.temp/
tmp/
temp/
.gemini/
