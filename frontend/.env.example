# ==============================================================================
# KAVACH (SMART HELMET) — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
#   1. Copy this file to `.env.local` inside `frontend/`.
#   2. Fill in the values for your Firebase project and hardware device ID.
#   3. Restart Expo with cache clearing: `npx expo start -c`.
#
# Client Note:
#   Variables prefixed with EXPO_PUBLIC_ are bundled into the client JS app.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & RUNTIME MODE
# ------------------------------------------------------------------------------
# "live": Connects to real Firebase RTDB & Auth.
# "demo": In-memory mock data with 10 interactive hardware/network scenarios.
EXPO_PUBLIC_DATA_SOURCE=live

# Helmet device ID (must match DEVICE_ID in firmware/KavachHelmet/config.h)
EXPO_PUBLIC_DEVICE_ID=HELMET_001

# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT WEB CONFIGURATION
# ------------------------------------------------------------------------------
# Firebase Web App keys (client identifiers; secured via database.rules.json)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 3. OPTIONAL CLIENT SMS WEBHOOK GATEWAY & EAS BUILD
# ------------------------------------------------------------------------------
EXPO_PUBLIC_EMERGENCY_SMS_GATEWAY_URL=
EXPO_PUBLIC_EMERGENCY_SMS_API_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=
