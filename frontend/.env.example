# ==============================================================================
# KAVACH (SMART HELMET) — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
#   1. Copy this file to `.env.local` inside `frontend/`.
#   2. Fill in the values for your Supabase project and hardware device ID.
#   3. Restart Expo with cache clearing: `npx expo start -c`.
#
# Client Security Note:
#   Variables prefixed with EXPO_PUBLIC_ are bundled into the client JS app.
#   NEVER put your Supabase service_role key or database password in this file!
#   Use only the Supabase Project URL and anon publishable key.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & RUNTIME MODE
# ------------------------------------------------------------------------------
# "live": Connects to real cloud backend (Supabase).
# "demo": In-memory hardware simulation with 10 interactive hardware/network scenarios.
EXPO_PUBLIC_DATA_SOURCE=live

# Backend selector
EXPO_PUBLIC_BACKEND=supabase

# Helmet device ID (must match DEVICE_ID in firmware/KavachHelmet/config.h)
EXPO_PUBLIC_DEVICE_ID=HELMET_001

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (PRIMARY BACKEND)
# ------------------------------------------------------------------------------
# Find these in your Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: Pre-configured test credentials for automated login during demos
EXPO_PUBLIC_SUPABASE_TEST_EMAIL=
EXPO_PUBLIC_SUPABASE_TEST_PASSWORD=

# ------------------------------------------------------------------------------
# 3. OPTIONAL CLIENT SMS WEBHOOK GATEWAY & EAS BUILD
# ------------------------------------------------------------------------------
EXPO_PUBLIC_EMERGENCY_SMS_GATEWAY_URL=
EXPO_PUBLIC_EMERGENCY_SMS_API_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=
