# ==============================================================================
# KAVACH (SMART HELMET) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
#   1. Copy this file to `.env` (or `.env.local` for local frontend development).
#   2. Fill in the values for your Firebase project and AWS account.
#   3. Never commit `.env` or `.env.local` containing real secrets to git.
#
# Client Note:
#   Variables prefixed with EXPO_PUBLIC_ are bundled into the client JS app.
#   Server secrets (AWS Secret Key, Service Account Keys) must NEVER use the
#   EXPO_PUBLIC_ prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & CLIENT RUNTIME
# ------------------------------------------------------------------------------
# Data source mode:
#   - "live": Connects to real Firebase RTDB & Auth (shows "LIVE_NOT_CONNECTED" if config missing).
#   - "demo": Runs completely offline using in-memory mock data with 10 interactive scenarios.
EXPO_PUBLIC_DATA_SOURCE=live

# Hardware identifier for the helmet.
# Must match the DEVICE_ID defined in ESP32 firmware (firmware/KavachHelmet/config.h).
EXPO_PUBLIC_DEVICE_ID=HELMET_001


# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT CONFIGURATION (FRONTEND / MOBILE APP)
# ------------------------------------------------------------------------------
# Firebase Web App client configuration for React Native / Expo.
# Obtain these values from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# These values are public client identifiers; security is strictly enforced
# by Firebase Realtime Database Security Rules (backend/firebase/database.rules.json).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=


# ------------------------------------------------------------------------------
# 3. AWS SNS EMERGENCY SMS CONFIGURATION (BACKEND & CLOUD FUNCTIONS)
# ------------------------------------------------------------------------------
# Used by Firebase Cloud Functions (backend/functions/awsSns.js) to dispatch
# Transactional emergency SMS with Google Maps coordinates to registered contacts.
#
# Create these credentials in AWS IAM with `sns:Publish` permissions (see terraform/).
#
# IMPORTANT FOR AWS SNS SMS SANDBOX:
# New AWS accounts start in SMS Sandbox mode. Emergency contact numbers (+91...)
# MUST be verified in the AWS SNS Console under:
#   Amazon SNS -> Text messaging (SMS) -> Sandbox destination phone numbers
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
AWS_USERNAME=kavach


# ------------------------------------------------------------------------------
# 4. FIREBASE ADMIN & SERVER-SIDE SCRIPTS
# ------------------------------------------------------------------------------
# Used by provisioning scripts (backend/functions/scripts/provision-device.js)
# and backend administrator tools.
FIREBASE_DATABASE_URL=

# Path to the Google Cloud / Firebase Admin service account JSON key.
# Required for running `node scripts/provision-device.js <deviceId> <ownerUid>`.
# Example: GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
GOOGLE_APPLICATION_CREDENTIALS=


# ------------------------------------------------------------------------------
# 5. OPTIONAL CLIENT-SIDE SMS GATEWAY & EAS BUILD (ADVANCED)
# ------------------------------------------------------------------------------
# Optional third-party HTTP SMS gateway webhook for direct app-side dispatch fallback
# (frontend/src/services/emergencyNotificationService.js).
# Leave blank to use native SMS composer fallback.
EXPO_PUBLIC_EMERGENCY_SMS_GATEWAY_URL=
EXPO_PUBLIC_EMERGENCY_SMS_API_KEY=

# Expo Application Services (EAS) Project UUID for push notification credentials.
# Generated via `npx eas-cli project:init` inside frontend/.
EXPO_PUBLIC_EAS_PROJECT_ID=
