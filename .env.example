# ==============================================================================
# KAVACH (SMART HELMET) — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
#   1. Copy this file to `.env` (or `.env.local` for local frontend development).
#   2. Fill in the values for your Supabase project.
#   3. Never commit `.env` or `.env.local` containing real secrets to git.
#
# Client Note:
#   Variables prefixed with EXPO_PUBLIC_ are bundled into the client JS app.
#   Server secrets must NEVER use the EXPO_PUBLIC_ prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & CLIENT RUNTIME
# ------------------------------------------------------------------------------
# Data source mode:
#   - "live": Connects to real cloud backend (Supabase).
#   - "demo": Runs completely offline using in-memory mock data with 10 interactive scenarios.
EXPO_PUBLIC_DATA_SOURCE=live

# Backend selector
EXPO_PUBLIC_BACKEND=supabase

# Hardware identifier for the helmet.
# Must match the DEVICE_ID defined in ESP32 firmware (firmware/KavachHelmet/config.h).
EXPO_PUBLIC_DEVICE_ID=HELMET_001

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (PRIMARY BACKEND)
# ------------------------------------------------------------------------------
# Public client configuration for React Native / Expo:
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: Dedicated demo user credentials for automatic login
EXPO_PUBLIC_SUPABASE_TEST_EMAIL=
EXPO_PUBLIC_SUPABASE_TEST_PASSWORD=

# Supabase CLI setup commands:
#   supabase login
#   supabase init
#   supabase link --project-ref your-project-id
#   supabase db push

# ------------------------------------------------------------------------------
# 3. OPTIONAL CLIENT SMS WEBHOOK GATEWAY & EAS BUILD
# ------------------------------------------------------------------------------
EXPO_PUBLIC_EMERGENCY_SMS_GATEWAY_URL=
EXPO_PUBLIC_EMERGENCY_SMS_API_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=