# ==============================================================================
# Production Environment Variables Example
# Copy to prod.tfvars (gitignored) and customize:
#   terraform apply -var-file="environments/prod.tfvars"
# ==============================================================================

project_name               = "kavach"
environment                = "prod"
aws_region                 = "ap-south-1"
iam_user_name              = "kavach-prod-dispatcher"
sns_sms_type               = "Transactional"
sns_monthly_spend_limit_usd = 50
log_retention_days         = 90
enable_cloudwatch_alarms   = true
emergency_alert_emails     = ["ops-oncall@kavach-helmet.example.com"]

tags = {
  Environment = "prod"
  Owner       = "sre-team"
  Criticality = "tier-1-emergency"
}
